# Copier en .env (jamais commité). Utilisé par Docker Compose et par l'API en local.
# Les valeurs ci-dessous sont des valeurs de développement, pas des secrets.

# --- PostgreSQL --------------------------------------------------------------
DATABASE_USER=rth
DATABASE_PASSWORD=mot-de-passe-local-a-changer
DATABASE_NAME=re_tired_hearts
# Hôte utilisé quand l'API tourne sur votre machine (npm run start:dev).
# Dans Docker Compose, l'API utilise toujours le service « db » sur le port 5432.
DATABASE_HOST=localhost
# Port de la machine redirigé vers le conteneur PostgreSQL.
# 5442 évite le conflit avec un PostgreSQL installé en local (5432).
DATABASE_PORT=5442
# true pour afficher les requêtes SQL dans les logs de l'API.
DATABASE_LOGGING=false

# --- API ---------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# Documentation OpenAPI interactive sur /api/docs.
SWAGGER_ENABLED=true
# Générer une valeur aléatoire pour chaque environnement ; ne jamais réutiliser ce texte d'exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacer-par-un-secret-aleatoire-d-au-moins-32-caracteres
# Nombre de reverse proxies de confiance devant l'API (0 = aucun) ; sert à la limitation de débit par IP.
# Docker Compose place nginx devant l'API : 1 par défaut. Mettre 0 si l'API est exposée directement.
TRUST_PROXY_HOPS=1
# --- Ports publiés (Docker Compose) ------------------------------------------
API_HOST_PORT=3000
WEB_HOST_PORT=8080

# --- Comptes de démonstration (npm run seed) ----------------------------------
# Identifiants fictifs publics uniquement ; ne pas utiliser sur une vraie base de membres.
# DEMO_PASSWORD=ReTiredDemo2026!
# Le seed refuse NODE_ENV=production sans une autorisation explicite à l'exécution.
# ALLOW_DEMO_SEED=true
